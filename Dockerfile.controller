# Multi-stage build for the Rust MultiTool controller.
# Builder stage: compile the Rust binary.
FROM rust:latest AS builder

WORKDIR /build

# Copy manifests first for dependency caching.
COPY Cargo.toml Cargo.lock ./
RUN mkdir -p src/bin && echo 'fn main() {}' > src/bin/main.rs && echo '' > src/lib.rs
RUN cargo build --release && rm -rf src

# Copy real source and rebuild.
COPY src/ src/
RUN touch src/bin/main.rs src/lib.rs && cargo build --release

# Runtime stage: minimal image.
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -r -u 1000 -s /usr/sbin/nologin controller
USER controller

COPY --from=builder /build/target/release/rust-cli-template /usr/local/bin/multitool-controller

ENTRYPOINT ["/usr/local/bin/multitool-controller"]
